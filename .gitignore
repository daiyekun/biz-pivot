# ========= 虚拟环境（最重要！） =========
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# ========= 环境变量 & 密钥（严禁上传！） =========
.env
.env.local
.env.dev
.env.prod
# 保留一份模板给团队参考，!表示不忽略这个示例文件
!.env.example

# ========= 日志文件 =========
logs/
*.log
*.log.*

# ========= Celery 相关临时文件 =========
celerybeat-schedule*
celerybeat.pid

