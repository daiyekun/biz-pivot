# ===================== PostgreSQL 业务数据库 =====================
PG_HOST=localhost
PG_PORT=5432
PG_USER=bizuser
PG_PASSWORD=Biz@Pass123
PG_DATABASE=biz_db
# sqlalchemy 连接串，代码可直接读取
PG_DATABASE_URL=postgresql+psycopg2://bizuser:Biz@Pass123@localhost:5432/biz_db

# ===================== Redis 缓存服务 =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Redis@123
REDIS_DB=0
REDIS_URL=redis://:Redis@123@localhost:6379/0

# ===================== RabbitMQ (Celery Broker) =====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=Admin@123
RABBITMQ_VHOST=/
# celery broker url
CELERY_BROKER_URL=amqp://admin:Admin@123@localhost:5672//
# celery 结果存储使用redis
CELERY_RESULT_BACKEND=redis://:Redis@123@localhost:6379/0

# ===================== Qdrant 向量数据库 =====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# qdrant http完整地址
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# ===================== Jaeger OpenTelemetry 链路追踪 =====================
# OTLP gRPC 地址，otel sdk上报用
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=biz-pivot-fastapi
