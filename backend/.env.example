# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=xxx
PG_PASSWORD=xxx
PG_DATABASE=xxx
PG_DATABASE_URL=postgresql+psycopg2://xxx:xxx@localhost:5432/xxx

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=xxx
REDIS_DB=0
REDIS_URL=redis://:xxx@localhost:6379/0

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=xxx
RABBITMQ_PASSWORD=xxx
RABBITMQ_VHOST=/
CELERY_BROKER_URL=amqp://xxx:xxx@localhost:5672//
CELERY_RESULT_BACKEND=redis://:xxx@localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# Jaeger OTel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=biz-pivot-fastapi
