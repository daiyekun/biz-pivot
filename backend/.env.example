# ===================== PostgreSQL 业务数据库 =====================
PG_HOST=localhost
PG_PORT=5432
PG_USER=xxx
PG_PASSWORD=xxx
PG_DATABASE=xxx
# 连接串由上方 PG_* 组件自动拼接（密码特殊字符自动转义），如需覆盖请用 URL 编码
# PG_DATABASE_URL=postgresql+psycopg2://xxx:xxx%40xxx@localhost:5432/xxx
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20

# ===================== Redis 缓存服务 =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=xxx
REDIS_DB=0
REDIS_URL=redis://:xxx@localhost:6379/0

# ===================== RabbitMQ (Celery Broker) =====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=xxx
RABBITMQ_PASSWORD=xxx
RABBITMQ_VHOST=/
CELERY_BROKER_URL=amqp://xxx:xxx@localhost:5672//
CELERY_RESULT_BACKEND=redis://:xxx@localhost:6379/0

# ===================== Qdrant 向量数据库 =====================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_chunks

# ===================== Jaeger OpenTelemetry 链路追踪 =====================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=biz-pivot-fastapi
OTEL_ENABLED=false

# ===================== 应用基础 =====================
APP_NAME=商枢 BizPivot 企业智能AI平台
APP_VERSION=0.1.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_INIT_DB=true

# ===================== 认证 / Token =====================
# JWT 密钥，生产环境务必改为 32 字节以上随机字符串
SECRET_KEY=biz-pivot-secret-key-change-me-2026
TOKEN_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=720

# ===================== 内置超级管理员 =====================
SUPER_ADMIN_ACCOUNT=admin
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_NAME=超级管理员

# ===================== LLM（OpenAI 兼容协议） =====================
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048

# ===================== 文件存储（预留 MinIO） =====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50